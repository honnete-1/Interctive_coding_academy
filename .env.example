# ---- CodeVerse environment template --------------------------------------
# Copy to .env (repo root) and adjust. Never commit real secrets.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Africa/Kigali

# Database: PostgreSQL recommended (docker compose up db). Unset => SQLite file fallback.
# DATABASE_URL=postgres://codeverse:codeverse@localhost:5432/codeverse

# Grader: where learner code runs for assessment (never inside Django).
#   docker     -> isolated container (production / recommended; requires a running Docker daemon)
#   subprocess -> separate local Python process. LOCAL DEV ONLY, not a security boundary.
GRADER_BACKEND=subprocess
GRADER_ALLOW_UNSAFE_SUBPROCESS=true
GRADER_DOCKER_IMAGE=python:3.12-alpine
GRADER_TIMEOUT_SECONDS=6

# Nova AI tutor (optional). With NOVA_PROVIDER=none, Nova says it is offline and authored hints still work.
NOVA_PROVIDER=none
# NOVA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
NOVA_MODEL=claude-opus-5-5
NOVA_EFFORT=low
NOVA_DAILY_REQUEST_LIMIT=60

# Frontend (Next.js)
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v0.29.5/full/
